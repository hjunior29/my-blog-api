BIND_ADDRESS=127.0.0.1:3000
DATABASE_URL=sqlite://blog.db
DATABASE_MAX_CONNECTIONS=4
RUST_LOG=info
APP_ENV=development
APP_ORIGIN=http://localhost:5173
SECURE_COOKIES=false
JWT_ISSUER=my-blog-api
JWT_AUDIENCE=my-blog
JWT_ACTIVE_KEY_ID=default
# JWT_SECRET=placeholder_local_jwt_secret_must_be_32_bytes_or_more
# JWT_KEYS_FILE=/path/to/jwt_keys.json
MEDIA_ROOT=./uploads
OWNER_ONLY=true
TWO_FACTOR_ENABLED=true

# SMTP Configuration
# SMTP_HOST=mail.smtp.com
# SMTP_PORT=587
# SMTP_USERNAME=noreply@example.com
# SMTP_PASSWORD=placeholder_smtp_password
# SMTP_FROM_EMAIL=noreply@example.com
# SMTP_FROM_NAME=Helder / Blog
